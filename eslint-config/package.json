{
  "author": "Ben Saufley <contact@bensaufley.com>",
  "bin": {
    "bslint": "./bin/lint.sh"
  },
  "bugs": {
    "url": "https://github.com/bensaufley/linters/issues"
  },
  "description": "ESLint config with Prettier, TypeScript, and Preact in mind",
  "devDependencies": {
    "@types/eslint": "*",
    "@types/node": "^20.19.27",
    "eslint": "^9.39.2",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/bensaufley/linters/tree/main/eslint-config#readme",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./index.js": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./preact": {
      "import": "./preact.js",
      "types": "./preact.d.ts"
    },
    "./preact.js": {
      "import": "./preact.js",
      "types": "./preact.d.ts"
    }
  },
  "name": "@bensaufley/eslint-config",
  "peerDependencies": {
    "@eslint/eslintrc": ">= 3.3.1",
    "@types/eslint": "^9.6.1",
    "eslint": ">= 9",
    "eslint-config-airbnb": ">= 19.0.4",
    "eslint-config-airbnb-base": ">= 15.0.0",
    "eslint-config-prettier": ">= 10",
    "eslint-import-resolver-typescript": ">= 3.6.1",
    "eslint-plugin-import": ">= 2.29.1",
    "eslint-plugin-jsx-a11y": ">= 6.8.0",
    "eslint-plugin-prefer-arrow-functions": ">= 3.2.4",
    "eslint-plugin-prettier": ">= 5.1.3",
    "eslint-plugin-react": ">= 7.33.2",
    "eslint-plugin-react-hooks": ">= 7",
    "eslint-plugin-simple-import-sort": ">= 10.0.0",
    "globals": ">= 13.24.0",
    "prettier": ">= 3.2.2",
    "typescript-eslint": "^8.50.1"
  },
  "peerDependenciesMeta": {
    "@types/eslint": {
      "optional": true
    },
    "eslint-config-airbnb": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bensaufley/linters.git"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "lint": "bslint",
    "format": "bslint --format",
    "check": "npm-run-all --parallel --continue-on-error --aggregate-output typecheck lint"
  },
  "overrides": {
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1"
  },
  "type": "module",
  "version": "2.0.0-0"
}
